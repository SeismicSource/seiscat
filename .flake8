[flake8]
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    *.egg-info,
    configobj,
    _version.py,

max-line-length = 79
ignore = E203, W503, D105, D200, D205, D400, D401, D412
# Test methods are self-documenting by their names; requiring docstrings on
# every test method adds noise without value.
per-file-ignores =
    tests/*:D102